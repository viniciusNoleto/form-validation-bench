{
  "name": "form-validation-bench",
  "version": "1.0.0",
  "description": "Experimentos do artigo \"Validação de formulários orientada a esquema com disparo por campo\"",
  "scripts": {
    "test": "vitest run tests",
    "typecheck": "tsc -p . && ngc -p tsconfig.angular.json --noEmit",
    "bench": "npm run bench:schema && npm run bench:types && npm run bench:react && npm run bench:vue && npm run bench:angular",
    "bench:runs": "node scripts/bench-runs.mjs",
    "bench:summary": "node scripts/summarize.mjs",
    "bench:schema": "node benchmarks/schema/bench.mjs",
    "bench:types": "node benchmarks/types/bench.mjs",
    "bench:react": "NODE_OPTIONS=--max-old-space-size=6144 vitest run benchmarks/react/structure --silent=false",
    "bench:vue": "NODE_OPTIONS=--max-old-space-size=6144 vitest run benchmarks/vue/structure --silent=false",
    "bench:angular": "NODE_OPTIONS=--max-old-space-size=6144 vitest run benchmarks/angular/structure --silent=false",
    "pitfalls": "node experiments/pitfalls/pitfalls.mjs | tee results/pitfalls.txt",
    "zod:probe": "node experiments/zod/probe.mjs",
    "zod:test": "vitest run experiments/zod",
    "initial": "vitest run experiments/initial --silent=false",
    "dev:react": "vite --config demo/react/vite.config.mjs",
    "dev:vue": "vite --config demo/vue/vite.config.mjs",
    "dev:angular": "vite --config demo/angular/vite.config.mjs",
    "gen:vue": "node benchmarks/vue/generate.mjs",
    "browser": "node experiments/browser/run.mjs"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.8",
    "@analogjs/vitest-angular": "^2.9.8",
    "@angular/build": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@primeuix/themes": "^3.1.1",
    "@spartan-ng/brain": "^1.10.0",
    "@spartan-ng/cli": "^1.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "immer": "^11.2.10",
    "jsdom": "^31.0.1",
    "lodash-es": "^4.18.1",
    "playwright": "^1.65.1",
    "primevue": "^4.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "tinybench": "^6.2.5",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "yup": "^1.7.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24.21 <25"
  }
}
