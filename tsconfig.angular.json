{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "noEmit": false,
    "types": []
  },
  "include": [
    "src/core/**/*.ts",
    "src/angular/**/*.ts",
    "src/schemas/basicSchema.ts",
    "tests/setup/angular.ts",
    "tests/**/angular-*.ts",
    "benchmarks/angular/**/*.ts",
    "experiments/zod/implementation/*Angular.ts",
    "experiments/zod/implementation/schemaForm.ts",
    "experiments/zod/implementation/basicSchema.ts",
    "experiments/zod/implementation/angular.test.ts",
    "experiments/initial/angular/frame.ts"
  ],
  "exclude": [
    "benchmarks/angular/**/*.test.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
